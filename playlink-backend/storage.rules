rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only the owner of an unexpired upload ticket can create its one pack file.
    // Reads are served using a Firebase download token issued after finalization.
    match /playlinks/{id}/pack.mrpack {
      function pendingUpload() {
        return firestore.get(/databases/(default)/documents/playLinkPending/$(id));
      }

      allow create: if request.auth != null
        && id.matches('^[A-Za-z0-9_-]{32}$')
        && request.resource.size > 0
        && request.resource.size <= 512 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream'
        && pendingUpload().data.ownerUid == request.auth.uid
        && pendingUpload().data.expiresAt > request.time;

      allow read, update, delete: if false;
    }
  }
}
